-- neotest-java jdtls buffer 오류 패치
-- jdtls 컴파일러의 버그를 런타임에 수정

local M = {}

M.patch_jdtls_compiler = function()
  -- neotest-java가 로드된 후 패치 적용
  local ok, _ = pcall(require, "neotest-java")
  if not ok then
    return
  end

  -- jdtls 컴파일러 모듈 패치
  local jdtls_compiler_path = "neotest-java.core.spec_builder.compiler.jdtls"
  local compiler_ok, compiler = pcall(require, jdtls_compiler_path)

  if compiler_ok then
    local original_compile = compiler.compile

    -- 패치된 compile 함수
    compiler.compile = function(args)
      -- 원본 함수를 래핑하여 buffer 처리 수정
      local nio = require("nio")
      local logger = require("neotest-java.logger")
      local _jdtls = require("neotest-java.command.jdtls")
      local scan = require("plenary.scandir")

      -- get_client 함수
      local function get_client(bufnr)
        local client_future = nio.control.future()
        nio.run(function()
          local clients = vim.lsp.get_clients({ name = "jdtls", bufnr = bufnr })
          client_future.set(clients and clients[1])
        end)
        return client_future:wait()
      end

      -- find_any_java_file 함수
      local function find_any_java_file(dir)
        return assert(
          vim.iter(nio.fn.globpath(dir or ".", "**/*.java", false, true)):next(),
          "No Java file found in the current directory."
        )
      end

      -- preload_file_for_lsp 함수
      local function preload_file_for_lsp(path)
        assert(path, "path cannot be nil")
        local buf = vim.fn.bufadd(path)
        vim.fn.bufload(path)
        return buf
      end

      -- 메인 컴파일 로직
      local client = get_client()
      local bufnr

      if not client then
        local any_java_file = assert(find_any_java_file(args.cwd), "No Java file found in the current directory.")
        bufnr = preload_file_for_lsp(any_java_file)

        assert(
          vim.wait(10000, function()
            client = get_client(bufnr)
            return not not client and not not client.initialized
          end, 1000),
          "jdtls client not started in time"
        )
      end

      logger.debug(("compilation in %s mode"):format(args.compile_mode))

      -- 버그 수정: callback 외부에서 buffer 번호 미리 캡처
      local final_bufnr = bufnr
      if not final_bufnr then
        -- nio.scheduler를 사용하여 메인 스레드에서 buffer 가져오기
        local buffer_future = nio.control.future()
        nio.run(function()
          nio.scheduler()
          buffer_future.set(vim.api.nvim_get_current_buf())
        end)
        final_bufnr = buffer_future:wait() or 0
      end

      nio.run(function(_)
        nio.scheduler()
        client:request(
          "java/buildWorkspace",
          { forceRebuild = args.compile_mode == "full" },
          function(err, result, ctx)
            if err then
              logger.error("compilation failed: " .. vim.inspect(err))
            end
          end,
          final_bufnr  -- 수정된 부분: 미리 캡처한 숫자 사용
        )
      end):wait()

      logger.debug("compilation complete!")

      logger.debug("scanning for test resources in " .. args.cwd)
      local resources = scan.scan_dir(args.cwd, {
        only_dirs = true,
        search_pattern = "test/resources$",
      })

      return _jdtls.get_classpath_file_argument(args.classpath_file_dir, resources)
    end

    vim.notify("✅ neotest-java jdtls buffer error patched!", vim.log.levels.INFO)
  end
end

-- autocmd로 neotest-java 로드 후 패치 적용
vim.api.nvim_create_autocmd("FileType", {
  pattern = "java",
  once = true,
  callback = function()
    vim.defer_fn(function()
      M.patch_jdtls_compiler()
    end, 100)
  end,
})

return M
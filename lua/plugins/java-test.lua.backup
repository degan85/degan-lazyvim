-- LazyVim Java Testing Configuration for 2024/2025
-- Maven/Spring Boot 프로젝트용 neotest-java 설정

return {
  -- Java LSP와 디버거 설정
  {
    "mfussenegger/nvim-jdtls",
    ft = "java",
  },

  -- Java 디버거
  {
    "mfussenegger/nvim-dap",
    dependencies = {
      "rcarriga/nvim-dap-ui",
      "theHamsta/nvim-dap-virtual-text",
    },
  },

  -- neotest-java 어댑터
  {
    "andy-bell101/neotest-java",
    ft = "java",
    dependencies = {
      "nvim-neotest/neotest",
      "nvim-lua/plenary.nvim",
      "nvim-treesitter/nvim-treesitter",
    },
  },

  -- neotest 메인 설정
  {
    "nvim-neotest/neotest",
    dependencies = {
      "nvim-neotest/nvim-nio",
      "nvim-lua/plenary.nvim",
      "antoinemadec/FixCursorHold.nvim",
      "nvim-treesitter/nvim-treesitter",
      "andy-bell101/neotest-java",
    },
    opts = {
      -- 어댑터 설정
      adapters = {
        ["neotest-java"] = {
          -- Maven 강제 사용 (Spring Boot 프로젝트)
          force_runner = "maven",

          -- 또는 프로젝트에 따라 자동 결정
          determine_runner = function(project_root_path)
            -- pom.xml이 있으면 Maven 사용
            if vim.fn.filereadable(project_root_path .. "/pom.xml") == 1 then
              return "maven"
            end
            -- build.gradle이 있으면 Gradle 사용
            if vim.fn.filereadable(project_root_path .. "/build.gradle") == 1 or
               vim.fn.filereadable(project_root_path .. "/build.gradle.kts") == 1 then
              return "gradle"
            end
            -- 기본값은 Maven
            return "maven"
          end,
        },
      },

      -- 테스트 실행 설정
      output = {
        enabled = true,
        open_on_run = true,
      },

      -- 테스트 결과 표시
      status = {
        enabled = true,
        virtual_text = true,
        signs = true,
      },

      -- 아이콘 설정
      icons = {
        child_indent = "│",
        child_prefix = "├",
        collapsed = "─",
        expanded = "╮",
        failed = "✖",
        final_child_indent = " ",
        final_child_prefix = "╰",
        non_collapsible = "─",
        passed = "✔",
        running = "⟳",
        running_animated = { "⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏" },
        skipped = "➜",
        unknown = "?",
      },
    },

    -- 키 매핑
    keys = {
      -- 테스트 실행
      { "<leader>tt", function() require("neotest").run.run(vim.fn.expand("%")) end, desc = "Run File Tests" },
      { "<leader>tr", function() require("neotest").run.run() end, desc = "Run Nearest Test" },
      { "<leader>tT", function() require("neotest").run.run(vim.loop.cwd()) end, desc = "Run All Test Files" },

      -- 디버그 모드로 테스트 실행
      { "<leader>td", function() require("neotest").run.run({strategy = "dap"}) end, desc = "Debug Nearest Test" },
      { "<leader>tD", function() require("neotest").run.run({vim.fn.expand("%"), strategy = "dap"}) end, desc = "Debug Test File" },

      -- 테스트 제어
      { "<leader>tS", function() require("neotest").run.stop() end, desc = "Stop Test" },
      { "<leader>ta", function() require("neotest").run.attach() end, desc = "Attach to Test" },

      -- 결과 보기
      { "<leader>ts", function() require("neotest").summary.toggle() end, desc = "Toggle Test Summary" },
      { "<leader>to", function() require("neotest").output.open({ enter = true, auto_close = true }) end, desc = "Show Test Output" },
      { "<leader>tO", function() require("neotest").output_panel.toggle() end, desc = "Toggle Output Panel" },

      -- 네비게이션
      { "[t", function() require("neotest").jump.prev({ status = "failed" }) end, desc = "Jump to Previous Failed Test" },
      { "]t", function() require("neotest").jump.next({ status = "failed" }) end, desc = "Jump to Next Failed Test" },
    },
  },
}